# Copy this file to .env and fill in the values:  cp env.example .env

# --- Database -------------------------------------------------------------
# Local dev uses a NATIVE PostgreSQL (Postgres.app), not Docker.
# On macOS Postgres.app the default superuser is your OS username, with no
# password. Replace `luxion` with your username, and create the db once:
#   createdb sitegap
DATABASE_URL="postgresql://luxion@localhost:5432/sitegap?schema=public"

# --- App ------------------------------------------------------------------
# Public base URL, exposed to the browser (must be prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- LLM provider (Phase 5) ----------------------------------------------
# Kept behind an adapter; the concrete provider is chosen in Phase 5.
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-2.0-flash"

# --- Internal admin (Phase 7) --------------------------------------------
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- Rate limiting (Phase 8) ---------------------------------------------
# Salt used to hash client IPs before storing rate-limit events.
# RATE_LIMIT_SALT="change-me"
